[core]
	editor = nvim
	excludesFile = ~/.gitignore
[user]
	name = David Sanchez
	email = {{.email}}
[color]
	status = auto
	branch = auto
	interactive = auto
	diff = auto
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
[credential]
    helper = store --file ~/.git-credentials
			
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
